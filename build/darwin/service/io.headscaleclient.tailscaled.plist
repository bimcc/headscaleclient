<plist version="1.0"><dict>
  <key>Label</key><string>io.headscaleclient.tailscaled</string>
  <key>ProgramArguments</key><array>
    <string>/Library/Application Support/BIMCC/HeadscaleClient/daemon/tailscaled</string>
    <string>--state=/Library/Application Support/BIMCC/HeadscaleClient/state/tailscaled.state</string>
